// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lastnik lokala (B2B stranka) — za samostojen pristop lastnika
model Owner {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  phone         String?
  businessName  String
  plan          String    @default("free") // free | premium | enterprise
  subscriptionStatus String @default("none") // none | active | canceled | past_due
  stripeCustomerId String?
  subscriptionEndsAt DateTime?
  // Ali je bil poslan opomnik za obnovitev (cron ga resetira ob podaljšanju)
  renewalReminderSent Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listings      Listing[]
  products      Product[]
  experiences   Experience[]
}

// Lokali (hotelir, restavracije, aktivnosti) — B2B listings za monetizacijo
model Listing {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  category        String // hotel | restaurant | bar | activity | shop | transport | other
  destinationId   String? // povezava z destinacijo iz slovenia-data.ts (ne FK)
  destinationName String?
  address         String
  phone           String?
  email           String?
  website         String?
  images          String // JSON array of URLs
  plan            String   @default("free") // free | premium | enterprise
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  priceRange      String   @default("€") // € | €€ | €€€
  openingHours    String?
  specialties     String? // JSON array
  ownerEmail      String?
  viewCount       Int      @default(0)
  clickCount      Int      @default(0)
  // AI priporočila tracking — šteje kolikokrat je bil lokal v AI itinererjih
  aiRecommendations Int    @default(0)
  leadCount       Int      @default(0)
  // Sponzorirane poti — lokal plača za vključitev v AI itinererje
  sponsored       Boolean  @default(false)
  sponsoredUntil  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String?
  owner           Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  events          ListingEvent[]

  @@index([destinationId])
  @@index([category])
  @@index([plan])
  @@index([featured])
  @@index([ownerId])
  @@index([sponsored])
}

// Tracking eventi za listings — impressions, clicks, AI recommendations, leads
model ListingEvent {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type        String   // impression | click | ai_recommendation | lead
  source      String?  // homepage | things-to-do | itinerary | search | ai_planner
  metadata    String?  // JSON string za dodatne podatke
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([type])
  @@index([createdAt])
}

// Tržnica izdelkov — lokalni kmetje, vinogradniki, obrtniki prodajajo izdelke
// Inspiracija: Etsy + farmsaround.com + Taste Slovenia
model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  category        String // food | wine | honey | oil | craft | souvenir | other
  destinationId   String? // povezava z destinacijo
  destinationName String?
  price           Float // EUR
  compareAtPrice  Float? // originalna cena (za popuste)
  currency        String   @default("EUR")
  images          String // JSON array of URLs
  // Logistika
  stock           Int      @default(0)
  sku             String?
  weight          Float? // gram
  // Atributi
  organic         Boolean  @default(false)
  handmade        Boolean  @default(false)
  local           Boolean  @default(true)
  vegan           Boolean  @default(false)
  // Trgovanje
  plan            String   @default("free") // free | premium
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  // Shipping
  shippingFree    Boolean  @default(false)
  shipsEurope     Boolean  @default(true)
  shipsWorldwide  Boolean  @default(false)
  // Kontakt prodajalca
  sellerName      String
  sellerEmail     String?
  sellerPhone     String?
  sellerWebsite   String?
  viewCount       Int      @default(0)
  saleCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String?
  owner           Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([destinationId])
  @@index([featured])
  @@index([ownerId])
}

// Tržnica izkušenj — vodniki, kuharji, instruktorji prodajajo izkušnje
// Inspiracija: Airbnb Experiences + GetYourGuide + Bókun
model Experience {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  category        String // tour | workshop | tasting | outdoor | cultural | adventure | wellness
  destinationId   String?
  destinationName String?
  // Cenitev
  pricePerPerson  Float // EUR
  currency        String   @default("EUR")
  // Trajanje in kapaciteta
  durationHours   Float // npr. 2.5
  minGroupSize    Int      @default(1)
  maxGroupSize    Int      @default(10)
  // Jeziki
  languages       String // JSON array: ["sl", "en", "de"]
  // Lokacija
  meetingPoint    String?
  address         String
  // Slike in kontakt
  images          String // JSON array of URLs
  providerName    String
  providerEmail   String?
  providerPhone   String?
  providerWebsite String?
  // Trgovanje
  plan            String   @default("free") // free | premium
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  // Atributi
  familyFriendly  Boolean  @default(false)
  accessibility   Boolean  @default(false)
  // Statistika
  viewCount       Int      @default(0)
  bookingCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String?
  owner           Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([destinationId])
  @@index([featured])
  @@index([ownerId])
}

// Naročila izdelkov (tržnica) — za sledenje plačil in dostave
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // IF-2025-001 format
  // Kupec
  buyerEmail      String
  buyerName       String
  buyerPhone      String?
  buyerAddress    String?
  buyerCity       String?
  buyerPostalCode String?
  buyerCountry    String   @default("SI")
  // Plačilo
  status          String   @default("pending") // pending | paid | shipped | delivered | canceled | refunded
  paymentMethod   String   @default("stripe") // stripe | demo | bank_transfer
  stripeSessionId String?
  // Zneski
  subtotal        Float // vsota izdelkov
  shippingCost    Float   @default(0)
  total           Float // subtotal + shipping
  currency        String   @default("EUR")
  // Items (JSON array: [{productId, name, price, quantity}])
  items           String
  // Tracking
  trackingNumber  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  @@index([buyerEmail])
  @@index([status])
  @@index([createdAt])
}

// Rezervacije izkušenj — za sledenje bookingov
model Booking {
  id              String   @id @default(cuid())
  bookingNumber   String   @unique // IF-EXP-001
  // Kupec
  guestEmail      String
  guestName       String
  guestPhone      String?
  // Izkušnja
  experienceId    String
  experienceName  String
  // Datum in ura
  bookingDate     DateTime // kdaj izkušnja poteka
  // Skupina
  groupSize       Int
  // Cenitev
  pricePerPerson  Float
  total           Float // pricePerPerson * groupSize
  currency        String   @default("EUR")
  // Status
  status          String   @default("pending") // pending | confirmed | completed | canceled
  paymentMethod   String   @default("stripe")
  stripeSessionId String?
  // Notes
  notes           String? // posebne želje gosta
  // Provider info (snapshot)
  providerName    String
  providerEmail   String
  meetingPoint    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  confirmedAt     DateTime?

  @@index([experienceId])
  @@index([bookingDate])
  @@index([guestEmail])
  @@index([status])
}
