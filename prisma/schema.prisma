// I Feel Slovenia - Prisma schema
// Slovenian tourism platform with destinations & AI itineraries

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Destination {
  id            String   @id
  slug          String   @unique
  name          String
  tagline       String
  region        String
  type          String
  description   String
  highlights    String // JSON array of strings
  bestFor       String // JSON array of strings
  activities    String // JSON array of strings
  bestSeason    String // JSON array of strings
  image         String
  lat           Float
  lng           Float
  rating        Float
  budget        String
  duration      String
  costPerPerson Int
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([region])
  @@index([type])
  @@index([featured])
}

model ItineraryRequest {
  id          String   @id @default(cuid())
  budget      Int
  days        Int
  interests   String // JSON array
  season      String
  groupSize   Int
  response    String // JSON itinerary
  source      String // "ai" | "fallback"
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
