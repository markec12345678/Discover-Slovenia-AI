// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// UPORABNIKI
// ============================================================================

// Registrirani uporabnik (B2C) — za shranjevanje itinererjev in preference
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  preferences   String?  // JSON: { interests, budget, groupSize, ... }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itineraries   SavedItinerary[]

  @@index([email])
}

// Lastnik lokala (B2B stranka) — za samostojen pristop lastnika
model Owner {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  phone         String?
  businessName  String
  plan          String    @default("free") // free | premium | enterprise
  role          String    @default("provider") // provider | moderator | admin | super_admin
  subscriptionStatus String @default("none") // none | active | canceled | past_due
  stripeCustomerId String?
  subscriptionEndsAt DateTime?
  // Ali je bil poslan opomnik za obnovitev (cron ga resetira ob podaljšanju)
  renewalReminderSent Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listings      Listing[]
  products      Product[]
  experiences   Experience[]
  sponsorships  Sponsorship[]

  @@index([email])
  @@index([plan])
  @@index([role])
  @@index([subscriptionStatus])
}

// Shranjeni itinererji (B2C) — anonimno shranjevanje + javno deljenje prek /pot/[shareId]
// userId je opcijski: itinerer lahko shrani anonimni obiskovalec (brez računa),
// prihodnje pa ga povežemo z registriranim uporabnikom.
model SavedItinerary {
  id          String   @id @default(cuid())
  userId      String?
  itinerary   String   // JSON: Itinerary object
  formData    String   // JSON: PlannerInput (ali null pri anonimnem shranjevanju)
  name        String?
  // Javni ID za deljenje (URL /pot/{shareId}) — nerodljiv, lowercase alnum
  shareId     String   @unique
  // Število ogledov deljene strani (public statistika)
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Glasovi obiskovalcev na lokacijah deljenih potovanj (/pot/[shareId])
// Skupinsko planiranje: vsak anonimni obiskovalec (voterId, client-generated)
// lahko glasuje za destination_id (locationKey) na točno enem deljenem tripu
// (shareId) — unique constraint to zagotavlja (idempotent insert).
model TripVote {
  id          String   @id @default(cuid())
  shareId     String
  locationKey String
  voterId     String
  createdAt   DateTime @default(now())

  @@unique([shareId, locationKey, voterId])
  @@index([shareId])
}

// ============================================================================
// LOKALCI (LISTINGS)
// ============================================================================

// Lokali (hotelir, restavracije, aktivnosti) — B2B listings za monetizacijo
model Listing {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  category        String // hotel | restaurant | bar | activity | shop | transport | other
  destinationId   String? // povezava z destinacijo iz slovenia-data.ts (ne FK)
  destinationName String?
  address         String
  phone           String?
  email           String?
  website         String?
  images          String // JSON array of URLs
  plan            String   @default("free") // free | premium | enterprise
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  priceRange      String   @default("€") // € | €€ | €€€
  openingHours    String?
  specialties     String? // JSON array
  ownerEmail      String?
  viewCount       Int      @default(0)
  clickCount      Int      @default(0)
  aiRecommendations Int    @default(0)
  leadCount       Int      @default(0)

  // === STATUS SISTEM (Faza 1) ===
  // Workflow: draft → pending → approved → published → archived → deleted
  status          String   @default("published") // draft | pending | approved | published | rejected | expired | archived | deleted
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?  // Admin ID (Owner.id)

  // === PARTNER SISTEM (Faza 1) ===
  // AI lahko razlikuje med navadnim/preverjenim/premium/featured partnerjem
  partnerStatus   String   @default("standard") // standard | verified | premium | featured
  partnerSince    DateTime? // kdaj je postal partner
  verifiedByAdmin Boolean  @default(false) // ali je admin ročno verificiral
  premiumUntil    DateTime? // do kdaj velja premium status (lahko različno od subscription)

  // Sponzorirane poti — lokal plača za vključitev v AI itinererje
  sponsored       Boolean  @default(false)
  sponsoredUntil  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String?
  owner           Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  events          ListingEvent[]
  sponsorships    Sponsorship[]

  @@index([destinationId])
  @@index([category])
  @@index([plan])
  @@index([featured])
  @@index([ownerId])
  @@index([sponsored])
  @@index([status])
  @@index([partnerStatus])
}

// Eventi za analitiko lokalov (impression/click/ai_recommendation/lead)
model ListingEvent {
  id         String   @id @default(cuid())
  listingId  String
  type       String   // impression | click | ai_recommendation | lead
  source     String?  // npr. "homepage" | "itinerary" | "search"
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// TRŽNICA
// ============================================================================

// Tržnica izdelkov — lokalni kmetje, vinogradniki, obrtniki prodajajo izdelke
model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  category        String // food | wine | honey | oil | craft | souvenir | other
  destinationId   String?
  destinationName String?
  price           Float
  compareAtPrice  Float?
  currency        String   @default("EUR")
  images          String // JSON array of URLs
  stock           Int      @default(0)
  sku             String?
  weight          Float?
  organic         Boolean  @default(false)
  handmade        Boolean  @default(false)
  local           Boolean  @default(true)
  vegan           Boolean  @default(false)
  plan            String   @default("free")
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  shippingFree    Boolean  @default(false)
  shipsEurope     Boolean  @default(true)
  shipsWorldwide  Boolean  @default(false)
  sellerName      String
  sellerEmail     String?
  sellerPhone     String?
  sellerWebsite   String?
  viewCount       Int      @default(0)
  saleCount       Int      @default(0)

  // Status sistem (Faza 1)
  status          String   @default("published")

  // UGC recenzije obiskovalcev (ločeno od demo rating/reviewCount iz CSV-seeda)
  reviews         Review[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String?
  owner           Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([destinationId])
  @@index([featured])
  @@index([ownerId])
  @@index([status])
}

// Tržnica izkušenj
model Experience {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  category        String // tour | workshop | tasting | outdoor | cultural | adventure | wellness
  destinationId   String?
  destinationName String?
  pricePerPerson  Float
  currency        String   @default("EUR")
  durationHours   Float
  minGroupSize    Int      @default(1)
  maxGroupSize    Int      @default(10)
  languages       String // JSON array
  meetingPoint    String?
  address         String
  images          String
  providerName    String
  providerEmail   String?
  providerPhone   String?
  providerWebsite String?
  plan            String   @default("free")
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  familyFriendly  Boolean  @default(false)
  accessibility   Boolean  @default(false)
  viewCount       Int      @default(0)
  bookingCount    Int      @default(0)

  // Status sistem (Faza 1)
  status          String   @default("published")

  // UGC recenzije obiskovalcev (ločeno od demo rating/reviewCount iz CSV-seeda)
  reviews         Review[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String?
  owner           Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([destinationId])
  @@index([featured])
  @@index([ownerId])
  @@index([status])
}

// ============================================================================
// UGC RECENZIJE (Faza 2)
// ============================================================================

// UGC mnenja obiskovalcev za izdelke in izkušnje tržnice — social proof.
// NAMENOMA ločeno od Product.rating/Experience.rating (demo podatki iz
// CSV-seeda): povprečje UGC se izračuna dinamično iz teh vrstic.
// productId XOR experienceId (ena od obeh, obe ne) — validacija v API-ju.
model Review {
  id           String   @id @default(cuid())
  productId    String?
  experienceId String?
  authorName   String
  rating       Int      // 1–5
  comment      String   // 10–1000 znakov (validirano v API-ju)
  createdAt    DateTime @default(now())

  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  experience   Experience?  @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([experienceId])
}

// ============================================================================
// NAROČILA IN REZERVACIJE
// ============================================================================

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  buyerEmail      String
  buyerName       String
  buyerPhone      String?
  buyerAddress    String?
  buyerCity       String?
  buyerPostalCode String?
  buyerCountry    String   @default("SI")
  status          String   @default("pending")
  paymentMethod   String   @default("stripe")
  stripeSessionId String?
  subtotal        Float
  shippingCost    Float   @default(0)
  total           Float
  currency        String   @default("EUR")
  items           String
  trackingNumber  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  @@index([buyerEmail])
  @@index([status])
  @@index([createdAt])
}

model Booking {
  id              String   @id @default(cuid())
  bookingNumber   String   @unique
  guestEmail      String
  guestName       String
  guestPhone      String?
  experienceId    String
  experienceName  String
  bookingDate     DateTime
  groupSize       Int
  pricePerPerson  Float
  total           Float
  currency        String   @default("EUR")
  status          String   @default("pending")
  paymentMethod   String   @default("stripe")
  stripeSessionId String?
  notes           String?
  providerName    String
  providerEmail   String
  meetingPoint    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  confirmedAt     DateTime?

  @@index([experienceId])
  @@index([bookingDate])
  @@index([guestEmail])
  @@index([status])
}

// ============================================================================
// SPONZORSTVA (Faza 1)
// ============================================================================

model Sponsorship {
  id              String   @id @default(cuid())
  listingId       String
  ownerId         String
  level           String   // basic | premium | featured
  amount          Float    // EUR
  currency        String   @default("EUR")
  status          String   @default("created") // created | paid | active | expiring | expired | cancelled | archived
  stripePaymentId String?
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner           Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([ownerId])
  @@index([status])
  @@index([endsAt])
}

// ============================================================================
// ANALITIKA (Faza 1)
// ============================================================================

// Ogled strani — funnel tracking (/api/track-funnel) in page analitika
// (/api/admin/track-pageview, /api/admin/indexing, /api/admin/leads-dashboard)
model PageView {
  id         String   @id @default(cuid())
  path       String
  funnelStep String?  // homepage_view | destination_view | itinerary_generate | newsletter_signup | listing_click
  title      String?
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([funnelStep])
  @@index([createdAt])
}

// Splošni analitični eventi (user behavior)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // ai_itinerary | ai_chat | smart_search | affiliate_click | newsletter_signup | page_view
  userId    String?
  sessionId String?
  metadata  String   // JSON
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
}

// AI uporaba — za stroškovno analizo in monitoring
model AIUsageLog {
  id           String   @id @default(cuid())
  feature      String   // itinerary | chat | search | refine | recommend | poi | tag | insights | faq | translate
  source       String   // puter | z-ai-sdk | fallback | cache
  success      Boolean
  responseTime Int      // ms
  costEur      Float    @default(0)
  userId       String?
  sessionId    String?
  metadata     String?  // JSON
  createdAt    DateTime @default(now())

  @@index([feature])
  @@index([source])
  @@index([createdAt])
  @@index([success])
}

// ============================================================================
// AUDIT LOG — sledenje admin/owner akcij (Faza 6)
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // Owner ID (kdo je naredil)
  actorEmail  String?  // email (za lažje iskanje)
  actorRole   String   // admin | owner | system | stripe
  action      String   // listing_approved | listing_rejected | sponsorship_activated | sponsorship_cancelled | plan_changed | featured_set | etc.
  resourceType String  // listing | sponsorship | owner | user
  resourceId  String?  // ID entitete
  resourceName String? // ime (za berljivost)
  metadata    String?  // JSON: dodatni podatki
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

// ============================================================================
// VPRAŠAJ LOKALCA — javna vprašanja obiskovalcev z grounded AI odgovori
// (Faza 2: social proof + "zero hallucination" diferenciacija)
// ============================================================================

model LocalQuestion {
  id              String    @id @default(cuid())
  question        String    // 10–500 znakov, trimmed
  answer          String?   // AI odgovor (grounded) — null dokler ni odgovorjen
  answerSource    String?   // "ai" | "fallback" — transparentnost odgovora
  destinationName String?   // ožji kontekst (npr. "Bled") — null = splošno vprašanje
  authorName      String?   // prikazno ime (2–40 znakov, neobvezno)
  isPublic        Boolean   @default(true) // admin lahko skrije neustrezno
  createdAt       DateTime  @default(now())
  answeredAt      DateTime?
  recommendedPartners String? // JSON array priporočenih partnerjev iz odgovora: [{ name, kind, category, destinationName, plan }]
  visitorId       String?   // anonimni obiskovalcev ID (piškotek ask_visitor) — števec dnevne brezplačne meje (1/dan, Faza 3b-2)

  @@index([isPublic, answeredAt])
  @@index([createdAt])
  @@index([visitorId, createdAt])
}

// ============================================================================
// PLAČLJIVE „VPRAŠAJ LOKALCA" KONZULTACIJE (Faza 3b-2)
// ============================================================================
// Freemium model: 1 brezplačno vprašanje/dan (števec nad LocalQuestion,
// vezan na anonimni piškotek) → globja osebna konzultacija kot plačljiv
// paket (krediti, vezani na e-pošto kupca — isti princip kot Order/Booking).
// Plačilo je DEMO (paymentMethod "demo"): naročilo in krediti so realni v
// bazi, zamenjava z varčno Stripe checkout potjo pa je kasneje le swap
// tega enega endpointa (stripeSessionId polje je pripravljeno).

// Naročilo paketa konzultacij (demo checkout)
model ConsultationOrder {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // KONZ-XXXXXX
  buyerEmail      String    // male črke, trimmed
  buyerName       String?   // prikazno ime (2–40 znakov)
  packageKey      String    // "single" (1×) | "pack3" (3×) — validirano proti ALLOWED_PACKAGES
  packageName     String    // berljivo ime paketa (za prikaz)
  credits         Int       // število podeljenih kreditov (1 | 3)
  amount          Float    // skupni znesek (9.9 | 19.9)
  currency        String    @default("EUR")
  status          String    @default("paid") // demo plačilo takoj "paid"; v produkciji pending → paid (webhook)
  paymentMethod   String    @default("demo") // "demo" (brez realnega terjatve) — pripravljeno za "stripe"
  stripeSessionId String?   // pripravljeno za produkcijo
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  creditRows         ConsultationCredit[] // krediti, podeljeni s tem naročilom

  @@index([buyerEmail])
  @@index([createdAt])
}

// Posamezen konzultacijski kredit (en nakup = N vrstic)
model ConsultationCredit {
  id         String    @id @default(cuid())
  email      String    // lastnik kupca (isti e-mail kot naročilo)
  orderId    String?   // ConsultationOrder.id — sledljivost izvora
  order      ConsultationOrder? @relation(fields: [orderId], references: [id])
  source     String    @default("purchase") // "purchase" | "bonus" (npr. promo/admin)
  status     String    @default("available") // available | used
  usedBy     String?   // Consultation.id, ki ga je porabil
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, status])
  @@index([orderId])
}

// Izvedena globoka konzultacija (1 kredit = 1 konzultacija)
model Consultation {
  id              String    @id @default(cuid())
  accessToken     String    @unique // privatna povezava /konzultacija/{token} (cuid — nedoglediv)
  email           String    // e-pošta kupca (re-access, vez s krediti)
  question        String    // 20–2000 znakov — podrobni opis potreb
  destinationName String?   // ožji kontekst (npr. "Bled") — null = vsa Slovenija
  travelDates     String?   // prosto besedilo (npr. "12.–19. julij")
  partyDescription String?  // prosto besedilo (npr. "2 odrasla + otroka 4 in 7")
  budget          String?   // ena izmed fiksnih vrednosti (npr. "300–600 €")
  interests       String?   // JSON array izbranih interesov (validirani seznam)
  answer          String?   // AI globok odgovor (grounded) — null dokler ni dostavljen
  answerSource    String?   // "ai" | "fallback" — transparentnost (isti princip kot LocalQuestion)
  recommendedPartners String? // JSON array citiranih partnerjev — isti format kot LocalQuestion
  status          String    @default("pending") // pending | delivered
  deliveredAt     DateTime?
  orderNumber     String?   // naročilo, iz katerega je bil kredit porabljen (sledljivost prihodka)
  createdAt       DateTime  @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// WEB PUSH NAROČNINE — VAPID (Faza 2: retention kanal)
// ============================================================================

model PushSubscription {
  id              String    @id @default(cuid())
  endpoint        String    @unique // push service URL (https)
  p256dh          String    // keys.p256dh iz browser subscription
  auth            String    // keys.auth iz browser subscription
  userAgent       String?   // za debug/segmentacijo
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  unsubscribedAt  DateTime? // soft-delete ko push service vrne 404/410

  // --- Dnevni opomnik za shranjeno potovanje (Task 3b) ---
  // kind="news": splošna naročnina (newsletter blok)
  // kind="trip": naročnina VEZANA na deljeni načrt /pot/{shareId} —
  //              dnevni cron pošlje dogodek + rezervacijo, dokler
  //              tripEnd ni pretečen. tripStart pomeni trenutek prijave
  //              (načrti nimajo absolutnih datumov — PlannerInput ima days+season).
  kind            String    @default("news")
  shareId         String?   // SavedItinerary.shareId (validiran ob prijavi)
  destinationIds  String?   // JSON array destination_id iz dni načrta
  tripStart       DateTime? // trenutek prijave (prvi dan opomnikov)
  tripEnd         DateTime? // tripStart + days — po tem datumu cron ne pošilja več
  lastPushAt      DateTime? // dnevni rate limit (max 1 push/24h na naročnino)

  @@index([unsubscribedAt])
  @@index([kind, unsubscribedAt])
  @@index([tripEnd])
}
