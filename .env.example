# Baza — schema.prisma je postgresql → OBVEZNO PostgreSQL URL (SQLite file: NE deluje).
# Brezplačna možnost: https://neon.tech (shema se ustvari z `bun run db:push`).
# V PILOTU/PRODUKCIJI: Neon pooler URL (sslmode=require&pgbouncer=true&connection_limit=1).
# POZOR: vrednost vsebuje & — če jo source-aš v bash, jo POSTAVI V NAREKOVAJE.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Legacy: Vercel demo baza (Faza 4e, SQLite era) — izklopljeno pri postgresql shemi
# DSA_DISABLE_DEMO_DB=1

# Admin — GENERIRAJ MOČNO GESLO (min 32 znakov, random)
ADMIN_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
ADMIN_EMAIL=admin@discoverslovenia.ai

# NextAuth — GENERIRAJ RANDOM SECRET (openssl rand -base64 32)
NEXTAUTH_SECRET=GENERIRAJ_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# AI PROVIDERJI (1.14.0) — veriga: OpenRouter → Gemini → Puter → z-ai (dev)
# ----------------------------------------------------------------------------
# OPENROUTER (PRIMARNI) — free tier, deluje iz VSAJ regije (tudi tam, kjer
# je Google geo-blokiran — razvojni sandbox). Pridobi ključ:
#   https://openrouter.ai/settings/keys (Create key, brez limite).
# NASTAVI NA: Vercel (Project → Settings → Environment Variables) in/ali
#             Render (Service → Environment) — ime: OPENROUTER_API_KEY.
# GitHub CI: ključ je shranjen kot Actions secret OPENROUTER_API_KEY
#            (preverjanje z .github/workflows/ai-smoke.yml).
# VARNOST: STREŽNIŠKI env (nikoli NEXT_PUBLIC_/VITE_).
# MODELI: :free pinani po ŽIVIH testih 2026-09-15 — nex-agi/nex-n2.5-pro:free
#   (čist JSON + odlična slovenščina; JSON mode podprt) z notranjim
#   fallbackom na nex-agi/nex-n2.5-mini:free. Vision na :free NEDELJUJE
#   (vision teče po Gemini → z-ai verigi). openrouter/free auto-router je
#   NEPREDVIDLJIV (izbral content-safety klasifikator) — NE uporabljaj.
# Rate limit free tier brez kredita: ~20 zahtev/min — za dev/pilot dovolj;
#   ko uporaba raste: dodaj $10 kredita (odpre višje limite) ALI preklopi
#   GEMINI na primarnega v produkciji (regije Vercel/Render so podprte).
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
#OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
#OPENROUTER_FALLBACK_MODEL=nex-agi/nex-n2.5-mini:free
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/

# GEMINI (SEKUNDARNI) — Google AI Studio, brezplačna stopnja (free tier).
# Pridobi ključ: https://aistudio.google.com/apikey
# NASTAVI NA: Vercel (Project → Settings → Environment Variables) in/ali
#             Render (Service → Environment) — ime: GEMINI_API_KEY.
# GitHub CI: ključ je shranjen kot Actions secret GEMINI_API_KEY
#            (preverjanje z .github/workflows/ai-smoke.yml).
# VARNOST: STREŽNIŠKI env (nikoli NEXT_PUBLIC_/VITE_ — glej SECURITY.md;
#          legacy VITE_GEMINI_API_KEY iz starih faz ODSTRANI iz Vercela).
# OPOMBA: API deluje iz podprtih regij (US/EU, kjer tečejo Vercel/Render);
#         razvojni sandbox je geo-blokiran — takrat veriga pošteno pade na
#         OpenRouter (primarni) ali z-ai; circuit breaker: 3 napake → 5 min.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Model (opcijsko): privzeto gemini-3.6-flash (uradno priporočeni naslednik
# umaknjenega gemini-2.5-flash). Alternativi: gemini-3.6-pro (kvaliteta),
# gemini-flash-latest (vedno najnovejši flash). Prek OpenAI-compat končne
# točke.
#GEMINI_MODEL=gemini-3.6-flash
# Base URL (opcijsko): privzeto uradna OpenAI-compat končna točka; preglasi
# SAMO za testne/poštni proxy namene.
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Puter (SEKUNDARNI) — free OpenAI-compatible API
PUTER_AUTH_TOKEN=YOUR_PUTER_AUTH_TOKEN
PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/
PUTER_MODEL=z-ai/glm-5.1

# ============================================================================
# DEPLOY ORODJA (1.15.0) — samo LOkalno (.env, gitignored); NIKOLI v repo!
# ----------------------------------------------------------------------------
# VERCEL_TOKEN — uporabnikov token (https://vercel.com/account/tokens).
# Omogoča scripts/ops/vercel-env-set.sh in deploy-check.sh BREZ argumentov.
# VERCEL_PROJECT_ID/NAME — iz Project → Settings → General (npr.
# prj_xxx / i-feel-slovenia). Uporabljeno živo 1.15.0 za potisk AI ključev.
VERCEL_TOKEN=YOUR_VERCEL_TOKEN
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID
VERCEL_PROJECT_NAME=YOUR_VERCEL_PROJECT_NAME
# (Render ekvivalent, ko ga priskrbiš: RENDER_API_KEY + RENDER_SERVICE_ID)

# Stripe (optional — demo mode brez ključev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Demo plačila v PRODUKCIJI (1.36.0 fail-closed): brez STRIPE_SECRET_KEY so
# na produkciji vsi plačilni tokovi (naročnina, sponzorstva, provizijski
# računi, demo rezervacije/naročila) ZAPRTI (503/501 z jasnim sporočilom).
# Demo vejo v produkciji vkloneš IZRECNO — nastavi na 1 SAMO na Vercel/Render
# (lokalni dev je demo sam od sebe, tu zastavica ni potrebna):
# DSA_DEMO_PAYMENTS=1

# SMTP (optional — console.log fallback v dev)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Discover Slovenia AI <noreply@discoverslovenia.ai>

# Cron — GENERIRAJ RANDOM SECRET
CRON_SECRET=GENERIRAJ_RANDOM_SECRET

# Ranking (optional override — JSON format)
# RANKING_WEIGHTS={"relevance":60,"quality":15,"rating":10,"distance":10,"premium":5}
# FEATURED_REQUIREMENTS={"minPlan":"premium","minQualityScore":90,"requireAdminVerification":true}

# Web push (VAPID) — generiraj z: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================================================
# GEO/SEO (MONET-10) — robots.txt / sitemap.xml / llms.txt / rss.xml / OG
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_URL — baza za ABSOLUTNE meta URL-je (og:image, canonical,
# JSON-LD), ki se spečejo ob buildu. NE nastavljaj lokalno (privzeto
# https://discoverslovenia.ai).
# - DOCKER/RENDER PRODUKCIJA: Dockerfile ARG že privzeto
#   https://i-feel-slovenia.onrender.com — preglasiš tako, da v Render
#   dashboard nastaviš NEXT_PUBLIC_BASE_URL=https://<lastna-domena>.
# - VERCEL: nastavi v dashboardu, sicer velja privzeta (mrtva) domena.
# robots.txt/sitemap.xml/llms.txt/rss.xml so GOSTITELJU-PRILAGOJENI (berejo
# Host zahteve) — teh env ne potrebujejo (src/lib/host.ts).
# IndexNow: ključ je public/<hex>.txt; ping po vsakem deployu:
#   bash /home/z/my-project/indexnow-ping.sh https://i-feel-slovenia.onrender.com
#NEXT_PUBLIC_BASE_URL=

# ============================================================================
# AFFILIATE MONETIZACIJA (fail-closed) — src/lib/affiliate.ts
# ----------------------------------------------------------------------------
# PRAVILA:
# - ID-ji so STREŽNIŠKI (nikoli NEXT_PUBLIC_) — vsi partner URL-ji se
#   generirajo v /go/[provider] redirectu.
# - PRAZNA vrednost = partner NI konfiguriran → povezava pelje na partnerjevo
#   stran BREZ trackinga in v analitiki se zapiše monetized:false.
# - Ne izmišljuj vrednosti — samo pravi ID-ji iz odobrenih partnerskih računov.
#
# DiscoverCars — tracking parameter je a_aid (affiliate ID/username iz
# programske prijave: discovercars.com/affiliate). Piškot 365 dni.
#DISCOVERCARS_AFFILIATE_CODE=
#
# Booking.com — Affiliate ID (aid) iz partnerskega računa
# (partnerhub/affiliates.support.booking.com).
#BOOKING_AFFILIATE_ID=
#
# GetYourGuide — Partner ID (Cookie ID) iz partner.getyourguide.com.
#GETYOURGUIDE_PARTNER_ID=
#
# Skyscanner — mediaPartnerId (Impact partner ID; program teče na Impact:
# developers.skyscanner.net/docs/referrals/tracking).
#SKYSCANNER_MEDIA_PARTNER_ID=
#
# World Nomads — program teče na CJ (Commission Junction) od nov. 2022;
# prilepi CELOTEN tracking URL, ki ga generira CJ vmesnik (https).
#WORLDNOMADS_AFFILIATE_URL=
#
# SAFETYWING (alternativa WN — direktni Ambassador program, brez omrežja):
# tracking parameter je referenceID na kateri koli safetywing.com strani.
# Prijavi se na safetywing.com/ambassador; ID je v dashboardu.
# Uporabi se SAMO če WORLDNOMADS_AFFILIATE_URL ni nastavljen (WN ima precedenco).
# Provizija: ~10 % potrošene premije, 364 dni.
#SAFETYWING_AMBASSADOR_ID=
#
# AIRALO — eSIM (internet takoj ob prihodu; direktni program teče na Impact,
# prijava partners.airalo.com; povezava iz Impact/Travelpayouts dashboarda).
# Prilepi CELOTEN https tracking URL (npr. https://airalo.sjv.io/c/… ali
# https://tp.media/r?marker=…&p=8310…).
#AIRALO_AFFILIATE_URL=
#
# KIWITAXI — letališčki/medkrajevni transferji (direktni program,
# kiwitaxi.com/en/partner/signup). Tracking parameter pap se pripne
# SAMODEJNO na povezavo (tudi deep-link from → to) — vnesi SAMO partner ID.
#KIWITAXI_PAP_ID=
#
# OMIO — vlaki/avtobusi (direktni program omio.com/affiliate IZDA povezavo
# po odobritvi — format ni javen; prek Travelpayouts: tp.media povezava).
# Prilepi CELOTEN https tracking URL iz dashborda.
#OMIO_AFFILIATE_URL=
#
# TIQETS — vstopnice brez čakalnih vrst (program na Awin: awin1.com/cread.php
# povezava iz Awin dashboarda; prek Travelpayouts: tp.media povezava).
# Prilepi CELOTEN https tracking URL iz dashborda.
#TIQETS_AFFILIATE_URL=
#
# VIATOR — vodeni izleti & ture (direktni program, prijava
# partnerresources.viator.com → Viator Selector orodje generira povezavo
# z pid/mcid na POLJUBNI viator.com strani — priporočamo Slovenijo/Ljubljano
# destinacijsko stran). Prijavni okno tudi prek ShareASale ali Travelpayouts.
# Prilepi CELOTEN https tracking URL (npr.
# https://www.viator.com/Slovenia/d4526-ttd?pid=P…&mcid=…).
# Provizija: 8 % končane rezervacije, piškot 30 dni (najdaljši v portfelju).
#VIATOR_AFFILIATE_URL=

# ============================================================================
# VIATOR PARTNER API (Task 45, 1.50.0) — DRUGI realni supply provider
# ----------------------------------------------------------------------------
# POGODBA (živo preverjena 18. 9. 2026, docs.viator.com/partner-api/technical
# + Golden Path za Basic Access affiliate partnerje):
#  - auth:        glava exp-api-key na VSAKEM klicu (brez ključa = HTTP 401)
#  - različica:   Accept: application/json;version=2.0 (OBVEZNA glava)
#  - jezik:       sl-SI vir NE podpira → vsebina pride v EN (dokumentirano)
#  - endpointi:   POST /products/search, GET /destinations,
#                 GET /products/{product-code} (Basic Access tier)
#  - rate limit:  okno 10 s na endpoint + skupni kap po IP (429 + Retry-After)
#
# KJUČ (self-serve po pogodbi Golden Path): registriraj partnerski račun
# (partnerresources.viator.com) → dashboard → Tools → Affiliate API →
# „Start your development" → potrdi e-pošto → ključ je generiran TAKOJ.
# VSA testiranja pred aktivacijo tečejo na sandboxu (VIATOR_API_BASE spodaj).
#
# BREZ KLJUČA je Viator plast na zemljevidu iskreno PRAZNA (opomba
# „not-configured" v telemetriji) — adapter NE simulira živega API-ja.
# S ključem v env živi sloj Aktivnosti/Ture oživi BREZ spremembe kode.
#VIATOR_API_KEY=
# Sandbox za integracijsko testiranje (produkcija je privzeta):
#VIATOR_API_BASE=https://api.sandbox.viator.com/partner
