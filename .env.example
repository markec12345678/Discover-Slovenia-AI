# Baza — schema.prisma je postgresql → OBVEZNO PostgreSQL URL (SQLite file: NE deluje).
# Brezplačna možnost: https://neon.tech (shema se ustvari z `bun run db:push`).
# V PILOTU/PRODUKCIJI: Neon pooler URL (sslmode=require&pgbouncer=true&connection_limit=1).
# POZOR: vrednost vsebuje & — če jo source-aš v bash, jo POSTAVI V NAREKOVAJE.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Legacy: Vercel demo baza (Faza 4e, SQLite era) — izklopljeno pri postgresql shemi
# DSA_DISABLE_DEMO_DB=1

# Admin — GENERIRAJ MOČNO GESLO (min 32 znakov, random)
ADMIN_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
ADMIN_EMAIL=admin@discoverslovenia.ai

# NextAuth — GENERIRAJ RANDOM SECRET (openssl rand -base64 32)
NEXTAUTH_SECRET=GENERIRAJ_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000

# Puter AI (free OpenAI-compatible API)
PUTER_AUTH_TOKEN=YOUR_PUTER_AUTH_TOKEN
PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/
PUTER_MODEL=z-ai/glm-5.1

# Stripe (optional — demo mode brez ključev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# SMTP (optional — console.log fallback v dev)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Discover Slovenia AI <noreply@discoverslovenia.ai>

# Cron — GENERIRAJ RANDOM SECRET
CRON_SECRET=GENERIRAJ_RANDOM_SECRET

# Ranking (optional override — JSON format)
# RANKING_WEIGHTS={"relevance":60,"quality":15,"rating":10,"distance":10,"premium":5}
# FEATURED_REQUIREMENTS={"minPlan":"premium","minQualityScore":90,"requireAdminVerification":true}

# Web push (VAPID) — generiraj z: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================================================
# AFFILIATE MONETIZACIJA (fail-closed) — src/lib/affiliate.ts
# ----------------------------------------------------------------------------
# PRAVILA:
# - ID-ji so STREŽNIŠKI (nikoli NEXT_PUBLIC_) — vsi partner URL-ji se
#   generirajo v /go/[provider] redirectu.
# - PRAZNA vrednost = partner NI konfiguriran → povezava pelje na partnerjevo
#   stran BREZ trackinga in v analitiki se zapiše monetized:false.
# - Ne izmišljuj vrednosti — samo pravi ID-ji iz odobrenih partnerskih računov.
#
# DiscoverCars — tracking parameter je a_aid (affiliate ID/username iz
# programske prijave: discovercars.com/affiliate). Piškot 365 dni.
#DISCOVERCARS_AFFILIATE_CODE=
#
# Booking.com — Affiliate ID (aid) iz partnerskega računa
# (partnerhub/affiliates.support.booking.com).
#BOOKING_AFFILIATE_ID=
#
# GetYourGuide — Partner ID (Cookie ID) iz partner.getyourguide.com.
#GETYOURGUIDE_PARTNER_ID=
#
# Skyscanner — mediaPartnerId (Impact partner ID; program teče na Impact:
# developers.skyscanner.net/docs/referrals/tracking).
#SKYSCANNER_MEDIA_PARTNER_ID=
#
# World Nomads — program teče na CJ (Commission Junction) od nov. 2022;
# prilepi CELOTEN tracking URL, ki ga generira CJ vmesnik (https).
#WORLDNOMADS_AFFILIATE_URL=
#
# SAFETYWING (alternativa WN — direktni Ambassador program, brez omrežja):
# tracking parameter je referenceID na kateri koli safetywing.com strani.
# Prijavi se na safetywing.com/ambassador; ID je v dashboardu.
# Uporabi se SAMO če WORLDNOMADS_AFFILIATE_URL ni nastavljen (WN ima precedenco).
# Provizija: ~10 % potrošene premije, 364 dni.
#SAFETYWING_AMBASSADOR_ID=
#
# AIRALO — eSIM (internet takoj ob prihodu; direktni program teče na Impact,
# prijava partners.airalo.com; povezava iz Impact/Travelpayouts dashboarda).
# Prilepi CELOTEN https tracking URL (npr. https://airalo.sjv.io/c/… ali
# https://tp.media/r?marker=…&p=8310…).
#AIRALO_AFFILIATE_URL=
#
# KIWITAXI — letališčki/medkrajevni transferji (direktni program,
# kiwitaxi.com/en/partner/signup). Tracking parameter pap se pripne
# SAMODEJNO na povezavo (tudi deep-link from → to) — vnesi SAMO partner ID.
#KIWITAXI_PAP_ID=
#
# OMIO — vlaki/avtobusi (direktni program omio.com/affiliate IZDA povezavo
# po odobritvi — format ni javen; prek Travelpayouts: tp.media povezava).
# Prilepi CELOTEN https tracking URL iz dashborda.
#OMIO_AFFILIATE_URL=
#
# TIQETS — vstopnice brez čakalnih vrst (program na Awin: awin1.com/cread.php
# povezava iz Awin dashboarda; prek Travelpayouts: tp.media povezava).
# Prilepi CELOTEN https tracking URL iz dashborda.
#TIQETS_AFFILIATE_URL=
#
# VIATOR — vodeni izleti & ture (direktni program, prijava
# partnerresources.viator.com → Viator Selector orodje generira povezavo
# z pid/mcid na POLJUBNI viator.com strani — priporočamo Slovenijo/Ljubljano
# destinacijsko stran). Prijavni okno tudi prek ShareASale ali Travelpayouts.
# Prilepi CELOTEN https tracking URL (npr.
# https://www.viator.com/Slovenia/d4526-ttd?pid=P…&mcid=…).
# Provizija: 8 % končane rezervacije, piškot 30 dni (najdaljši v portfelju).
#VIATOR_AFFILIATE_URL=
